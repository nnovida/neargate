# NearGate environment. Copy to .env and fill in. .env is git-ignored: never commit it.
#
# Secrets (the *_PRIVATE_KEY values, ANTHROPIC_API_KEY, a real admin token) belong in your
# environment or in .env, never in this file. An account's key can also stay where the near CLI
# wrote it, ~/.near-credentials/<network>/<account>.json (npm run near:bootstrap puts it there),
# in which case its *_KEY_PATH and *_PRIVATE_KEY lines stay empty.
#
# Put a comment on its own line: the .env loader does not strip text after a value.

# --- mode ---
# mock = the offline devnet (npm run dev, npm run demo); live = NEAR (npm run dev:live).
AGENTGATE_MODE=mock

# --- ports ---
DEVNET_PORT=4030
ORACLE_PORT=4010
MIDDLEWARE_PORT=4021
DASHBOARD_PORT=3000

# --- mock mode ---
DEVNET_URL=http://localhost:4030
# Demo accounts (npm run neargate -- demo-accounts prints them); empty = unset.
MOCK_BUYER_ACCOUNT=
MOCK_SELLER_ACCOUNT=

# --- gateway ---
# Live mode refuses this default: set a long random token (it guards /admin/services).
AGENTGATE_ADMIN_TOKEN=dev-admin-token
INVOICE_TTL_MS=300000
UPSTREAM_TIMEOUT_MS=30000
# Optional: a JSON file path keeps issued invoices across gateway restarts. Empty = in memory.
INVOICE_STORE_PATH=
# Optional: a JSON file path keeps pending attestations across restarts and replays them on boot.
ATTESTATION_QUEUE_PATH=
# debug | info | warn | error
LOG_LEVEL=info
# Trusted reverse-proxy hops in front of the gateway (1 behind a single Railway/Vercel proxy).
# Never set it above the real hop count: X-Forwarded-For becomes spoofable.
TRUST_PROXY=0

# --- NEAR (live mode) ---
# testnet | mainnet
NEAR_NETWORK=testnet
# Leave empty for the network defaults (rpc.testnet.near.org, testnet.nearblocks.io).
NEAR_RPC_URL=
NEAR_EXPLORER_URL=
# The neargate-registry contract account: printed by npm run near:deploy. Empty = the deployed
# default, neargate-1112-registry.testnet.
REGISTRY_CONTRACT_ID=
# The four accounts npm run near:bootstrap creates (<prefix>-gateway.testnet and so on).
# Gateway: signs attestations, and is registered as each service's attestor.
GATEWAY_ACCOUNT_ID=
# ed25519:<base58> secret key. Leave empty to use GATEWAY_KEY_PATH or ~/.near-credentials.
GATEWAY_PRIVATE_KEY=
# A near-cli credentials JSON file ({account_id, public_key, private_key}).
GATEWAY_KEY_PATH=
# Seller: owns and registers services (neargate wrap, npm run near:seed).
SELLER_ACCOUNT_ID=
SELLER_PRIVATE_KEY=
SELLER_KEY_PATH=
# Buyer: pays for calls (neargate buy, the buyer agent, npm run near:seed). Must not be the seller.
BUYER_ACCOUNT_ID=
BUYER_PRIVATE_KEY=
BUYER_KEY_PATH=
# The gasless rail: 1 lets the gateway relay a buyer's signed pay_from_escrow (a NEP-366 delegate)
# and pay its gas from GATEWAY_ACCOUNT_ID, which it then requires. 0 answers such a proof relayer_disabled.
RELAYER_ENABLED=0

# --- dashboard (hosted: pm2, docker compose or Vercel; see deploy/README.md) ---
# The dashboard's server only reads the chain. It needs AGENTGATE_MODE=live plus NEAR_NETWORK,
# NEAR_RPC_URL, NEAR_EXPLORER_URL and REGISTRY_CONTRACT_ID from the NEAR section above, and no
# account id, key or admin token. pm2 does not read this file for it, so the ecosystem file copies
# those four values over; docker compose and Vercel take them from their own settings.
# The docs pages are rendered at build time, and Next inlines NEXT_PUBLIC_* values then: export
# these before `npm run build` (NEAR_EXPLORER_URL too, when it is not testnet.nearblocks.io). An
# unset or empty value falls back to the built-in default, so they are not set here.
#   NEXT_PUBLIC_SITE_URL=https://<dashboard-host>
#     the origin for canonical links, OpenGraph and the sitemap
#   NEXT_PUBLIC_NEAR_EXPLORER_URL=https://<explorer>
#     optional; the docs pages fall back to NEAR_EXPLORER_URL, then testnet.nearblocks.io
#   NEXT_PUBLIC_REPO_URL=https://<source repository>
#     optional; the GitHub links in the nav, footer and home page show only when it is set

# --- testnet scripts (npm run near:seed, npm run smoke:live) ---
# Public URL of the running gateway. The registry stores it for good as the service's
# gateway_base_url, so there is no localhost default. Required by near:seed.
GATEWAY_PUBLIC_URL=
# Public API the seed wraps. Empty = https://open.er-api.com/v6/latest/USD.
SEED_UPSTREAM_URL=
# Dev-only, 1 = let near:seed register a loopback gateway (it stays registered at that URL).
SEED_ALLOW_LOCAL_GATEWAY=
# smoke:live checks this service id (default 1); naming one makes a missing service an error.
SMOKE_SERVICE_ID=
# Dev-only, 1 = let smoke:live request the invoice from a loopback gateway.
SMOKE_ALLOW_LOCAL_GATEWAY=

# --- LLM (buyer agent) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# Budget cap per agent run, in NEAR (price + the 0.002 NEAR storage fee per call).
BUYER_BUDGET_NEAR=1

# --- oracle ---
# 1 = serve deterministic fixture data (offline demo).
ORACLE_STATIC=0
