{
  "name": "@neargate/cli",
  "version": "0.2.1",
  "private": true,
  "description": "Wrap any HTTP API into a paid x402 service on NEAR — HTTP 402 micropayments in native NEAR with on-chain discovery and reputation.",
  "type": "module",
  "bin": {
    "neargate": "dist/bin.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "license": "MIT",
  "keywords": [
    "near",
    "x402",
    "http-402",
    "ai-agents",
    "micropayments",
    "agentgate",
    "web3",
    "cli"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.0.0",
    "near-api-js": "7.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@agentgate/chain": "*",
    "@agentgate/client": "*",
    "@agentgate/shared": "*",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0"
  }
}
