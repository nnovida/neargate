  "bin": { "agentgate": "./dist/bin.js" },
  "exports": { ".": "./src/index.ts" },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22" },
  "license": "MIT",
  "homepage": "https://example.invalid/AgentGate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://example.invalid/AgentGate.git",
    "directory": "packages/cli"
  },
  "bugs": { "url": "https://example.invalid/AgentGate/issues" },
  "keywords": ["casper", "x402", "http-402", "ai-agents", "micropayments", "agentgate", "web3", "cli"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "exports": { ".": "./dist/index.js" }
