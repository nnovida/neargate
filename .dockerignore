# Keep the Docker build context tiny — only manifests + package sources are
# COPY'd by packages/*/Dockerfile, but everything NOT listed here still gets
# uploaded to the daemon as context.

.git
node_modules
**/node_modules

# Rust build artifacts (~7 GB) + contract sources — never needed in images.
contracts

# Next.js app: the dashboard image (dashboard/Dockerfile) builds it, the other images only need
# dashboard/package.json (`npm ci` validates the lockfile against EVERY workspace manifest).
# dashboard/test imports workspaces the dashboard image does not carry, and `next build`
# type-checks everything under dashboard/.
dashboard/test
**/.next

# Runtime/local state.
logs
data
packages/middleware/data
**/*.log
**/tsconfig.tsbuildinfo

# Not part of any image.
e2e
docs
scripts
.env
.env.*
!.env.example
.vercel
.vercelignore
vercel.json
docker-compose*.yml
Dockerfile
**/Dockerfile
